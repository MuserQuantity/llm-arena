# === Database ===
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/llm_arena

# === LLM API ===
# OpenAI-compatible API endpoint and key for model execution
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here

# === Auth ===
# Admin login credentials (REQUIRED - app will not start without these)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-me-to-a-random-secret-string

# JWT token expiration in minutes (default: 1440 = 24 hours)
# JWT_EXPIRE_MINUTES=1440

# === CORS ===
# Comma-separated list of allowed origins (default: http://localhost:3000)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
